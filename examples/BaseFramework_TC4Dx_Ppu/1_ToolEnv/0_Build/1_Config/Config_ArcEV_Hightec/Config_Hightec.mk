B_HIGHTEC_ARCEV_PATH= C:\Tools\Compilers\HighTec_Ppu_v1.0.3\toolchains\arcv2\v1.0.3

B_HIGHTEC_BUILD_CONFIG= tc4d

B_HIGHTEC_ARCEV_ARCH= av2hs

B_HIGHTEC_ARCEV_NO_CORE_LIB= -no-core-library

B_HIGHTEC_ARCEV_CC_OPTIONS= -march=$(B_HIGHTEC_ARCEV_ARCH) -mcpu=$(B_HIGHTEC_BUILD_CONFIG) $(B_HIGHTEC_ARCEV_NO_CORE_LIB) -DIFX_ILLD_PPU_USAGE \
                          -O2 -g -fshort-enums -ffunction-sections -fdata-sections

B_HIGHTEC_ARCEV_CC_OPTIONS_KERNEL= $(B_HIGHTEC_ARCEV_CC_OPTIONS)

B_HIGHTEC_ARCEV_ASM_OPTIONS= -march=$(B_HIGHTEC_ARCEV_ARCH) -mcpu=$(B_HIGHTEC_BUILD_CONFIG) $(B_HIGHTEC_ARCEV_NO_CORE_LIB)

B_HIGHTEC_ARCEV_LD_OPTIONS= -march=$(B_HIGHTEC_ARCEV_ARCH) -mcpu=$(B_HIGHTEC_BUILD_CONFIG) $(B_HIGHTEC_ARCEV_NO_CORE_LIB) -lcrt0 \
                             -Wl,--gc-sections -Wl,-Csections -Wl,-Csize -Wl,-Csymbols -Wl,-Cunmangle

#Include path for library directories. Add each path with following format as shown below.
#Each path prefixed with -L and separated by a space.
#B_HIGHTEC_ARCEV_LIB_INC=-L<path>[ -L<path>][..]
B_HIGHTEC_ARCEV_LIB_INC=

#Libraries to include shall be listed with option -l, with following format.
#B_HIGHTEC_ARCEV_LIBS=-l<lib name>[ -l<lib name>][..]
B_HIGHTEC_ARCEV_LIBS=
